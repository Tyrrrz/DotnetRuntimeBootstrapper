<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <Import Project="DotnetRuntimeBootstrapper.props" />

  <!-- Props for local testing, used by the demo projects -->
  <PropertyGroup>
    <DotnetRuntimeBootstrapperTaskAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'"
      >$(MSBuildThisFileDirectory)/bin/$(Configuration)/netstandard2.0/DotnetRuntimeBootstrapper.dll</DotnetRuntimeBootstrapperTaskAssembly
    >
    <DotnetRuntimeBootstrapperTaskAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'"
      >$(MSBuildThisFileDirectory)/bin/$(Configuration)/net472/DotnetRuntimeBootstrapper.dll</DotnetRuntimeBootstrapperTaskAssembly
    >
  </PropertyGroup>
</Project>
