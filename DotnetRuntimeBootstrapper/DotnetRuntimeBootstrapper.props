<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <GenerateBootstrapperOnBuild Condition="'$(GenerateBootstrapperOnBuild)' == ''"
      >false</GenerateBootstrapperOnBuild
    >
  </PropertyGroup>

  <PropertyGroup>
    <DotnetRuntimeBootstrapperTaskAssembly Condition="'$(MSBuildRuntimeType)' == 'Core'"
      >$(MSBuildThisFileDirectory)/../tasks/netstandard2.0/DotnetRuntimeBootstrapper.dll</DotnetRuntimeBootstrapperTaskAssembly
    >
    <DotnetRuntimeBootstrapperTaskAssembly Condition="'$(MSBuildRuntimeType)' != 'Core'"
      >$(MSBuildThisFileDirectory)/../tasks/net472/DotnetRuntimeBootstrapper.dll</DotnetRuntimeBootstrapperTaskAssembly
    >
  </PropertyGroup>

  <UsingTask
    TaskName="DotnetRuntimeBootstrapper.BootstrapperTask"
    AssemblyFile="$(DotnetRuntimeBootstrapperTaskAssembly)"
  />
</Project>
